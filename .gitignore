# ==========================================
# Unity .gitignore
# ==========================================

# Unity temporary and generated folders
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
Recordings/

# Asset Store tools & JetBrains Rider plugin cache
[Aa]ssets/AssetStoreTools*
[Aa]ssets/Plugins/Editor/JetBrains*

# Autogenerated addressables & temporary streaming cache
[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*
[Aa]ssets/[Ss]treamingAssets/aa.meta
[Aa]ssets/[Ss]treamingAssets/aa/*

# ==========================================
# IDE & Editor files
# ==========================================
# Visual Studio / Visual Studio Code / JetBrains Rider
.vs/
.vscode/
.idea/
ExportedObj/
.consulo/

# MSBuild / Solution files autogenerated by Unity
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.uid

# Unity autogenerated meta files for temporary files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# ==========================================
# Builds & Packaging
# ==========================================
*.apk
*.aab
*.unitypackage
*.app
*.exe
*.ipa

# Gradle cache directory
.gradle/

# Crashlytics generated file
crashlytics-build.properties

# Crash & diagnostic reports
sysinfo.txt
*.stackdump

# ==========================================
# Operating System Files
# ==========================================
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Windows
ehthumbs.db
Thumbs.db
desktop.ini
